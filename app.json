{
  "expo": {
    "name": "Ambar",
    "slug": "CocktailApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "cocktailapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0C0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cocktailapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0C0A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cocktailapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location to show nearby bars on the map."
        }
      ]
    ]
  }
}
